    <!-- Sidebar -->
    <div class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">Wheelz</div>
      <div class="sidebar-menu">
        <a href="/admin/dashboard" class="nav-item">
          <i class="fa-solid fa-qrcode"></i> Dashboard
        </a>
        <a href="/admin/products" class="nav-item active">
          <i class="fa-solid fa-box"></i> Products
        </a>
        <a href="/admin/categories" class="nav-item">
          <i class="fa-solid fa-layer-group"></i> Categories
        </a>
        <a href="/admin/orders" class="nav-item">
          <i class="fa-solid fa-cart-shopping"></i> Orders
        </a>
        <a href="/admin/sales" class="nav-item">
            <i class="fa-solid fa-money-bill-wave"></i> Sales & Revenue
        </a>
        <a href="/admin/users" class="nav-item">
          <i class="fa-solid fa-user-group"></i> Users
        </a>
        <a href="/admin/coupons" class="nav-item">
           <i class="fa-solid fa-ticket"></i> Coupons
        </a>
      </div>
      <div class="sidebar-footer">
        <a href="/admin/logout" class="logout-link">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
      </div>
    </div>

    <!-- Mobile Overlay -->
    <div class="admin-overlay" id="adminOverlay"></div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <header class="admin-header">
        <button class="admin-hamburger" id="adminHamburger">
          <i class="fa-solid fa-bars"></i>
        </button>
        <h2>ADMIN PANEL</h2>
      </header>

      <div class="content-body">
        
        <!-- Title Section -->
        <div class="page-title-block">
            <h1 class="page-main-title">ADD NEW PRODUCT</h1>
            <p class="page-sub-title">ADD NEW PRODUCT</p>
        </div>

        <!-- Form Card -->
        <div class="form-card">
            <h2 class="form-card-title">Add Product</h2>
            <p class="form-card-subtitle">Create a new listing for the toy car collection.</p>
            
            <form class="add-product-form" enctype="multipart/form-data">
                <div class="form-dual-layout">
                    <!-- Left Column -->
                    <div class="form-column">
                        <div class="form-group" id="nameDiv">
                            <label for="productName">Product Name</label>
                            <input type="text" id="productName" name="name" placeholder="e.g. Speedster Pro Gen 2" >
                            <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                        </div>
                        
                        <div class="form-group" id="categoryDiv">
                            <label for="category">Category</label>
                            <select id="category" name="category" class="categorySelect">
                                <option value="" disabled selected>Select Category</option>

                                <% if (categories && categories.length > 0) { %>
                                    <% categories.forEach(category => { %>
                                        <option value="<%= category?._id %>">
                                            <%= category?.name %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                              <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                        </div>

                        <div class="form-row-inline">
                            <div class="form-group flex-1" id="priceDiv">
                                <label for="price">Price ($)</label>
                                <input type="number" id="price" name="price" >
                                <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                            </div>
                            <div class="form-group flex-1" id="stockDiv">
                                <label for="stock">Stock Quantity</label>
                                <input type="number" id="stock" name="stock" placeholder="0">
                                <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                            </div>
                        </div>

                        <div class="form-group" id="offerDiv">
                            <label for="offer">offer</label>
                            <input type="text" id="offer" name="offer" placeholder="">
                            <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                        </div>

                        <div class="form-group" id="specificationDiv">
                            <label for="specifications">Specifications</label>
                            <textarea id="specifications" name="specifications" placeholder="Detailed product specifications and features..."></textarea>
                            <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="form-column">
                        <label class="field-label">Product Images (Min 3)</label>

                      <!-- Small Upload Box -->
                      <div class="small-upload-box" id="dropZone">
                          <i class="fa-solid fa-plus"></i>
                          <p>Add Image</p>
                          <input type="file"
                                id="productImage"
                                name="images"
                                multiple
                                hidden
                                accept="image/*">
                      </div>

                      <p class="image-error-msg" id="imageError"></p>

                      <!-- Preview Grid -->
                      <div class="preview-grid" id="previewContainer"></div>

                        <div class="form-group mt-20">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" placeholder="Detailed product description and features..."></textarea>
                            <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                        </div>

                        <div class="form-group" id="shortnameDiv">
                            <label for="shortName">Short Name</label>
                            <input type="text" id="shortName" name="shortName" placeholder="">
                            <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                        </div>
                    </div>
                </div>

                <!-- Form Footer Actions -->
                <div class="form-footer-actions">
                    <button type="button" class="btn-submit-product" onclick="productValidation(event)">
                        <i class="fa-solid fa-save"></i> Add Product
                    </button>
                    <a href="/admin/products" class="btn-cancel-product">
                        <i class="fa-solid fa-xmark"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
      </div>
    </div>

    <script>
      // Sidebar Toggle Logic
      const hamburger = document.getElementById("adminHamburger");
      const sidebar = document.getElementById("adminSidebar");
      const overlay = document.getElementById("adminOverlay");

      hamburger.addEventListener("click", () => {
        sidebar.classList.add("sidebar-open");
        overlay.classList.add("active");
      });

      overlay.addEventListener("click", () => {
        sidebar.classList.remove("sidebar-open");
        overlay.classList.remove("active");
      });

      // Simple click-to-upload for the drop zone
      const dropZone = document.getElementById("dropZone");
const fileInput = document.getElementById("productImage");
const previewContainer = document.getElementById("previewContainer");

window.productImages = [];

dropZone.addEventListener("click", () => fileInput.click());
let removeAddImageCount=0;
fileInput.addEventListener("change", function (e) {

    removeAddImageCount++;
    if(removeAddImageCount===5){
      document.getElementById('dropZone').style.display='none'
    }

    const files = Array.from(e.target.files);

    files.forEach(file => {

        window.productImages.push(file);

        const reader = new FileReader();

        reader.onload = function (event) {

            const previewItem = document.createElement("div");
            previewItem.classList.add("preview-item");

            const img = document.createElement("img");
            img.src = event.target.result;

            const removeBtn = document.createElement("button");
            removeBtn.innerText = "×";
            removeBtn.classList.add("remove-btn");

            removeBtn.addEventListener("click", function () {

                const index = Array.from(previewContainer.children)
                                   .indexOf(previewItem);
              removeAddImageCount--;
              document.getElementById('dropZone').style.display='flex'
                window.productImages.splice(index, 1);
                previewItem.remove();
            });

            previewItem.appendChild(img);
            previewItem.appendChild(removeBtn);

            previewContainer.appendChild(previewItem);
        };

        reader.readAsDataURL(file);
    });

    fileInput.value = "";
});

        function productValidation(event){
          
           let isValid = true;

          // 🔹 Get values
          const name = document.getElementById('productName').value.trim();
          const category = document.getElementById('category').value;
          const price = parseFloat(document.getElementById('price').value);
          const stock = parseInt(document.getElementById('stock').value);
          const offer = document.getElementById('offer').value.trim();
          const specifications = document.getElementById('specifications').value.trim();
          const description = document.getElementById('description').value.trim();
          const shortName=document.getElementById('shortName').value.trim();

          const images = window.productImages || []; // you must store images here

          // 🔹 Div references
          const nameDiv = document.getElementById('nameDiv');
          const categoryDiv = document.getElementById('categoryDiv');
          const priceDiv = document.getElementById('priceDiv');
          const stockDiv = document.getElementById('stockDiv');
          const offerDiv = document.getElementById('offerDiv');
          const specificationDiv = document.getElementById('specificationDiv');
          const shortnameDiv=document.getElementById('shortnameDiv')

          const nameError = nameDiv.querySelector('p');
          const categoryError = categoryDiv.querySelector('p');
          const priceError = priceDiv.querySelector('p');
          const stockError = stockDiv.querySelector('p');
          const offerError = offerDiv.querySelector('p');
          const specificationError = specificationDiv.querySelector('p');
          const shortnameError=shortnameDiv.querySelector('p');

          const imageDiv = document.getElementById('dropZone');
          const imageError = document.getElementById('imageError');

          // 🔹 Reset
          resetField(nameDiv, nameError);
          resetField(categoryDiv, categoryError);
          resetField(priceDiv, priceError);
          resetField(stockDiv, stockError);
          resetField(offerDiv, offerError);
          resetField(specificationDiv, specificationError);
          
          //image 
          imageError.style.display = 'none';
          imageError.innerText = '';

          // 🔥 Name validation
          if (!name) {
              showerror(nameDiv, nameError, "Product name is required");
              isValid = false;
          } else if (name.length < 3) {
              showerror(nameDiv, nameError, "Minimum 3 characters required");
              isValid = false;
          }

          // 🔥 Category validation
          if (!category) {
              showerror(categoryDiv, categoryError, "Category is required");
              isValid = false;
          }
          //short name
          if (!shortName) {
              showerror(shortnameDiv, shortnameError, "shortName is required");
              isValid = false;
          }

          // 🔥 Price validation
          if (isNaN(price) || price <= 0) {
              showerror(priceDiv, priceError, "Price must be greater than 0");
              isValid = false;
          }

          // 🔥 Stock validation
          if (isNaN(stock) || stock < 0) {
              showerror(stockDiv, stockError, "Stock cannot be negative");
              isValid = false;
          }

          // 🔥 Offer validation (optional but must be valid number if entered)
          if (!offer) {
              const offerNumber = parseFloat(offer);
              if (isNaN(offerNumber) || offerNumber < 0 || offerNumber > 90) {
                  showerror(offerDiv, offerError, "Offer must be between 0 and 90%");
                  isValid = false;
              }
          }

          // 🔥 Specification validation
          if (!specifications) {
              showerror(specificationDiv, specificationError, "Specifications are required");
              isValid = false;
          }

          // 🔥 Description validation
          if (!description || description.length < 10) {
              showerror(
                  document.getElementById('description').parentElement,
                  document.getElementById('description').parentElement.querySelector('p'),
                  "Description must be at least 10 characters"
              );
              isValid = false;
          }

          // 🔥 Image validation (Minimum 3 images)
          if (!images || images.length < 3) {
              imageError.style.display = 'block';
              imageError.innerText = "Minimum 3 images required";
          }else{
            imageError.style.display = 'none';
            imageError.innerText = '';
          }
         

          if (!isValid) return;
        }
        function showerror(div, errorElement, message) {
    const field = div.querySelector('input, textarea, select');
    if (field) field.style.border = '1px solid red';

    if (errorElement) {
        errorElement.style.display = 'block';
        errorElement.innerText = message;
    }
}

function resetField(div, errorElement) {
    const field = div.querySelector('input, textarea, select');
    if (field) field.style.border = '1px solid #ccc';

    if (errorElement) {
        errorElement.style.display = 'none';
        errorElement.innerText = '';
    }
}
    </script>
