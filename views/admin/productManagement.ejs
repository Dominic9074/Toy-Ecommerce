    <!-- Sidebar -->
    <div class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">Wheelz</div>
      <div class="sidebar-menu">
        <a href="/admin/dashboard" class="nav-item">
          <i class="fa-solid fa-qrcode"></i> Dashboard
        </a>
        <a href="/admin/products" class="nav-item active">
          <i class="fa-solid fa-box"></i> Products
        </a>
        <a href="/admin/category" class="nav-item">
          <i class="fa-solid fa-layer-group"></i> Categories
        </a>
        <a href="/admin/orders" class="nav-item">
          <i class="fa-solid fa-cart-shopping"></i> Orders
        </a>
        <a href="/admin/sales" class="nav-item">
            <i class="fa-solid fa-money-bill-wave"></i> Sales & Revenue
        </a>
        <a href="/admin/users" class="nav-item">
          <i class="fa-solid fa-user-group"></i> Users
        </a>
        <a href="/admin/coupons" class="nav-item">
           <i class="fa-solid fa-ticket"></i> Coupons
        </a>
      </div>
      <div class="sidebar-footer">
        <a href="/admin/logout" class="logout-link">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
      </div>
    </div>

    <!-- Mobile Overlay -->
    <div class="admin-overlay" id="adminOverlay"></div>

    <!-- Main Content -->
    <div class="admin-content">
      <!-- Header -->
      <header class="admin-header">
        <button class="admin-hamburger" id="adminHamburger">
          <i class="fa-solid fa-bars"></i>
        </button>
        <h2>ADMIN PANEL</h2>
        <!-- Search Bar -->
        <form action="/admin/products" method="GET">
          <div class="search-bar-container">
                <input type="hidden" name="status">
                <input 
                    type="text" 
                    name="search"
                    placeholder="Search users..."
                    id="searchInput"
                    value="<%= search || '' %>">
                    <input type="hidden" name="status" value="<%= status || '' %>">
                    <input type="hidden" name="sort" value="<%= sort || '' %>">
                <button type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                <button type="button" class="clearSearch" onclick="clearSearch()" >Clear</button>
                </div>

        </form>
      </header>

      <div class="content-body">
        
        <!-- Title & Add Button Section -->
        <div class="product-header-row">
            <div class="page-title-block">
                <h1 class="page-main-title">PRODUCT</h1>
                <p class="page-sub-title">MANAGE YOUR CAR INVENTORY TOYS</p>
            </div>

            <form method="GET" action="/admin/products" class="filter-form">

              <!-- Status Filter -->
              <select name="status" onchange="this.form.submit()">
                  <option value="">All Status</option>
                  <option value="Active" <%= status === "Active" ? "selected" : "" %>>
                      Active
                  </option>
                  <option value="Inactive" <%= status === "Inactive" ? "selected" : "" %>>
                      Inactive
                  </option>
              </select>

              <!-- Sort Filter -->
              <select name="sort" onchange="this.form.submit()">
                  <option value="">Default Sort</option>
                  <option value="price_asc" <%= sort === "price_asc" ? "selected" : "" %>>
                      Price: Low to High
                  </option>
                  <option value="price_desc" <%= sort === "price_desc" ? "selected" : "" %>>
                      Price: High to Low
                  </option>
                  <option value="stock_asc" <%= sort === "stock_asc" ? "selected" : "" %>>
                      Stock: Low to High
                  </option>
                  <option value="stock_desc" <%= sort === "stock_desc" ? "selected" : "" %>>
                      Stock: High to Low
                  </option>
              </select>
              <input type="hidden" name="search" value="<%= search || '' %>">
          </form>
            
            <a href="/admin/addProducts" class="btn-add-product">
                <i class="fa-solid fa-circle-plus"></i> ADD PRODUCT
            </a>
        </div>

        <!-- Table -->
        <div class="product-table-container">
          <table class="custom-table product-table">
            <thead>
              <tr>
                <th style="width: 25%;">PRODUCT NAME</th>
                <th style="width: 20%;">CATORY</th>
                <th style="width: 15%;">PRICE</th>
                <th style="width: 15%;">STOCK</th>
                <th style="width: 15%;">STATUS</th>
                <th style="width: 10%; text-align: right;">ACTIONS</th>
              </tr>
            </thead>
            <tbody>
              <% if (products && products.length > 0) { %>

                <% products.forEach(product => { %>
                  <tr>
                    <td class="product-name-cell">
                      <%= product?.name %>
                    </td>

                    <td>
                      <%= product.category?.name || "No Category" %>
                    </td>

                    <td>
                      ₹<%= product?.price %>
                    </td>

                    <td>
                      <%= product?.stock %> Unit
                    </td>

                    <td class="<%= product?.isActive ? 'status-active-text' : 'status-inactive-text' %>">
                      <%= product?.isActive ? "ACTIVE" : "INACTIVE" %>
                    </td>

                    <td style="text-align: right;">
                      <div class="product-action-group">

                        <!-- Delete -->
                        <button 
                          class="btn-icon-delete"
                          onclick="updateStatus('<%= product?._id %>')">
                          <i class="fa-solid fa-trash"></i>
                        </button>

                        <!-- Edit -->
                        <a href="/admin/edit-product/<%= product?._id %>">
                          <button class="btn-icon-edit">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                          </button>
                        </a>

                      </div>
                    </td>
                  </tr>
                <% }) %>

              <% } else { %>

                <tr>
                  <td colspan="6" style="text-align:center;">
                    No products found
                  </td>
                </tr>

              <% } %>
            </tbody>
          </table>

          <!-- Pagination -->
          <div class="pagination-wrapper">
             <div class="pagination">
                <a href="?page=<%= page - 1 %>&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link">&lt;</a>
                <a href="?page=1&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link <%= page === 1 ? 'active' : '' %>">1</a>
                <a href="?page=2&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link <%= page === 2 ? 'active' : '' %>">2</a>
                <a href="?page=3&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link <%= page === 3 ? 'active' : '' %>">3</a>
                <a href="?page=<%= page + 1 %>&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link">&gt;</a>
             </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Sidebar Toggle Logic
      const hamburger = document.getElementById("adminHamburger");
      const sidebar = document.getElementById("adminSidebar");
      const overlay = document.getElementById("adminOverlay");

      hamburger.addEventListener("click", () => {
        sidebar.classList.add("sidebar-open");
        overlay.classList.add("active");
      });

      overlay.addEventListener("click", () => {
        sidebar.classList.remove("sidebar-open");
        overlay.classList.remove("active");
      });
      function clearSearch(){
            const search=document.getElementById('searchInput');
            search.value=''
            window.location.href='/admin/products'
        }
        function updateStatus(productId){
          Swal.fire({
            title: "Are you sure?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Change Status!"
          }).then((result) => {
            if (result.isConfirmed) {
              fetch(`/admin/addProduct/status/${productId}`,{
                method:"PATCH"
              }).then(res=>res.json())
              .then(data=>{
                if(data.success){
                  showSuccess(data.message)
                  setTimeout(()=>{
                    window.location.reload();
                  },1000)
                }else{
                  showError(data.message)
                }
              })
            }
          });
        }
    </script>
