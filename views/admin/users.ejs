    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            Wheelz
        </div>
        
        <nav class="sidebar-menu">
            <a href="#" class="nav-item">
                <i class="fa-solid fa-border-all"></i>
                Dashboard
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-box"></i>
                Products
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-list"></i>
                Categories
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-cart-shopping"></i>
                Orders
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-money-bill-trend-up"></i>
                Sales & Revenue
            </a>
            <a href="#" class="nav-item active"> <!-- Active Class for User Mgmt -->
                <i class="fa-solid fa-users"></i>
                Users
            </a>
        </nav>
        
        <div class="sidebar-footer">
            <a href="/admin/logout" class="logout-link">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                Logout
            </a>
        </div>
    </aside>
    <div class="admin-overlay" id="adminOverlay"></div>

    <!-- Main Content -->
    <div class="admin-content">
        <!-- Top Header -->
        <header class="admin-header">
            <button class="admin-hamburger" id="adminHamburger">
            <i class="fa-solid fa-bars"></i>
            </button>
            <h2>ADMIN PANEL</h2>
            <form method="GET" action="/admin/users">
                <div class="search-bar-container">
                <input type="hidden" name="status" value="<%= status || 'all' %>">
                <input 
                    type="text" 
                    name="search"
                    placeholder="Search users..."
                    id="searchInput"
                    value="<%= search || '' %>">
                    
                <button type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                <button type="button" class="clearSearch" onclick="clearSearch()" >Clear</button>
                </div>
            </form>
        </header>

        <!-- Page Content -->
        <div class="content-body">
            
            <div class="page-header">
                <div>
                    <h1 class="page-title">USER MANAGEMENT</h1>
                    <p class="page-subtitle">SEE ALL YOUR USER AND ADD NEW USERS</p>
                </div>
                <div class="filter-container">
                    <h2 class="filter-title">FILTER</h2>

                    <div class="filter-row">
                        <span class="filter-label">STATUS:</span>

                        <a href="?status=all&search=<%= search || '' %>" 
                        class="filter-btn <%= (!status || status === 'all') ? 'active' : '' %>">
                        ALL
                        </a>

                        <a href="?status=blocked&search=<%= search || '' %>" 
                        class="filter-btn <%= status === 'blocked' ? 'active' : '' %>">
                        BLOCKED
                        </a>

                        <a href="?status=active&search=<%= search || '' %>" 
                        class="filter-btn <%= status === 'active' ? 'active' : '' %>">
                        UNBLOCKED
                        </a>

                    </div>
                    </div>
            </div>

            <!-- Users Table -->
            <div class="table-container">
                <div class="table-scroll">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>USER DETAILS</th>
                            <th>EMAIL ADDRESS</th>
                            <th>REGISTRATION DATE</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>

                        <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="4">No users found</td>
                        </tr>
                        <% } %>

                        <% users.forEach(function(user) { %>

                        <tr>
                        <td>
                            <span class="user-name"><%= user.name %></span>
                        </td>

                        <td><%= user.email %></td>

                        <td>
                            <%= new Date(user.createdAt).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "short",
                                day: "2-digit"
                                }) %>
                        </td>

                        <td>
                            <% if (user.status === "active") { %>
                            <button 
                                class="btn-action-text btn-block"
                                onclick="toggleUserStatus('<%= user._id %>', 'block')">
                                Block
                            </button>
                            <% } else { %>
                            <button 
                                class="btn-action-text btn-unblock"
                                onclick="toggleUserStatus('<%= user._id %>', 'unblock')">
                                Unblock
                            </button>
                            <% } %>
                        </td>

                        </tr>

                        <% }) %>

                        </tbody>

                </table>
                </div>
                <!-- Pagination -->
                <div class="pagination">
                    <% if (page > 1) { %>
                        <a href="?page=<%= page - 1 %>&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link">&lt;</a>
                    <% } %>

                    <a href="?page=1&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link <%= page === 1 ? 'active' : '' %>">1</a>


                    <a href="?page=2&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link <%= page === 2 ? 'active' : '' %>">2</a>

                    <% 
                        let thirdPage = page > 3 ? page : 3;
                    %>

                    <a href="?page=<%= thirdPage %>&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link <%= page === thirdPage ? 'active' : '' %>">
                        <%= thirdPage %>
                    </a>

                    <% if (page < totalPages) { %>
                        <a href="?page=<%= page + 1 %>&search=<%= search || '' %>&status=<%= status || 'all' %>" 
                        class="page-link">&gt;</a>
                    <% } %>
                </div>
            </div>

        </div>
    </div>

    <script>

        function toggleUserStatus(userId,action){
            Swal.fire({
                title: "Are you sure?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Confirm"
                }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/users/${userId}/${action}`, {
                    method: "PATCH"
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success){
                    window.location.reload();
                    } else {
                    showError(data.message)
                    }
                });
                    }
                    });
            
        }
        function clearSearch(){
            const search=document.getElementById('searchInput');
            search.value=''
            window.location.href='/admin/users'
        }

        const adminHamburger = document.getElementById("adminHamburger");
        const adminSidebar = document.querySelector(".admin-sidebar");
        const adminOverlay = document.getElementById("adminOverlay");

        adminHamburger.addEventListener("click", () => {
            adminSidebar.classList.add("sidebar-open");
            adminOverlay.classList.add("active");
        });

        adminOverlay.addEventListener("click", () => {
            adminSidebar.classList.remove("sidebar-open");
            adminOverlay.classList.remove("active");
        });

    </script>

