    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            Wheelz
        </div>
        
        <nav class="sidebar-menu">
            <a href="#" class="nav-item">
                <i class="fa-solid fa-border-all"></i>
                Dashboard
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-box"></i>
                Products
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-list"></i>
                Categories
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-cart-shopping"></i>
                Orders
            </a>
            <a href="#" class="nav-item">
                <i class="fa-solid fa-money-bill-trend-up"></i>
                Sales & Revenue
            </a>
            <a href="#" class="nav-item active"> <!-- Active Class for User Mgmt -->
                <i class="fa-solid fa-users"></i>
                Users
            </a>
        </nav>
        
        <div class="sidebar-footer">
            <a href="/admin/logout" class="logout-link">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                Logout
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="admin-content">
        <!-- Top Header -->
        <header class="admin-header">
            <h2>ADMIN PANEL</h2>
            <form method="GET" action="/admin/users">
                <div class="search-bar-container">
                <input 
                    type="text" 
                    name="search"
                    placeholder="Search users..."
                    value="<%= search || '' %>">
                    
                <button type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                </div>
            </form>
        </header>

        <!-- Page Content -->
        <div class="content-body">
            
            <div class="page-header">
                <h1 class="page-title">USER MANAGEMENT</h1>
                <p class="page-subtitle">SEE ALL YOUR USER AND ADD NEW USERS</p>
            </div>

            <!-- Users Table -->
            <div class="table-container">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>USER DETAILS</th>
                            <th>EMAIL ADDRESS</th>
                            <th>REGISTRATION DATE</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>

                        <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="4">No users found</td>
                        </tr>
                        <% } %>

                        <% users.forEach(function(user) { %>

                        <tr>
                        <td>
                            <span class="user-name"><%= user.name %></span>
                        </td>

                        <td><%= user.email %></td>

                        <td>
                            <%= new Date(user.createdAt).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "short",
                                day: "2-digit"
                                }) %>
                        </td>

                        <td>
                            <% if (user.status === "active") { %>
                            <button 
                                class="btn-action-text btn-block"
                                onclick="toggleUserStatus('<%= user._id %>', 'block')">
                                Block
                            </button>
                            <% } else { %>
                            <button 
                                class="btn-action-text btn-unblock"
                                onclick="toggleUserStatus('<%= user._id %>', 'unblock')">
                                Unblock
                            </button>
                            <% } %>
                        </td>

                        </tr>

                        <% }) %>

                        </tbody>

                </table>
                
                <!-- Pagination -->
                <div class="pagination">
                    <a href="#" class="page-link">&lt;</a>
                    <a href="#" class="page-link active">1</a>
                    <a href="#" class="page-link">2</a>
                    <span class="page-link">3</span>
                    <a href="#" class="page-link">&gt;</a>
                </div>
            </div>

        </div>
    </div>

    <script>

        function toggleUserStatus(userId,action){
            fetch(`/admin/users/${userId}/${action}`, {
                method: "PATCH"
            })
            .then(res => res.json())
            .then(data => {
                if(data.success){
                window.location.reload();
                } else {
                showError(data.message)
                }
            });
        }

    </script>

