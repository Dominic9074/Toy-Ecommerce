
      <header>
  
  <!-- Hamburger Button (Mobile Only) -->
  <button class="hamburger" id="hamburger" type="button">
  <i class="fa-solid fa-bars"></i>
  </button>

  <ul class="nav-links" id="mobileMenu">
    <li><a href="#">Home</a></li>
    <li><a href="/shop">Shop</a></li>
    <li><a href="#">Categories</a></li>
  </ul>

  <div class="logo">Wheelz</div>

  <div class="user-actions nav-links" style="list-style-type: none; padding-left: 0; margin: 0;">
    <li><a href="/order">Order</a></li>
    <li><a href="/shop">Cart</a></li>
    <li><a href="/wishlist">Wishlist</a></li>

    <% if (user) { %>
      <a href="/user/profile" class="profile-avatar">
        <%= user.username.charAt(0).toUpperCase() %>
      </a>
    <% } else { %>
      <a href="/signin" class="sign-in-btn">Sign In</a>
    <% } %>
  </div>

</header>

    <!-- Hero Section -->
    <section class="hero">
      <div class="big-text-bg">MUSTANG</div>
      <div class="hero-content">
        <div class="hero-info">
          <h1>Buy Your Dream Toys</h1>
          <span class="subtitle">Collect The Finest Toy Cars Today.</span>
          <a href="#" class="btn-primary">Order Now ></a>
        </div>
        <div class="hero-image">
          <img
            src="images/Hoonigang.bgstripped.png"
            alt="Mustang Toy Car"
          />
        </div>
      </div>
    </section>

    <!-- Brands Section -->
    <section class="brands">
      <div class="section-title">Brands</div>
      <div class="brand-logos">
        <img
          src="images/Hot-Wheels-LOGO.webp"
          alt="Hot Wheels"
        />
        <img src="images/RC logo.png" alt="RC" />
        <img class="brand-logo" src="images/LEGO LOGO.png" alt="LEGO" />
      </div>
    </section>

    <!-- Explore Section -->
    <section class="explore">
      <div class="section-title">Explore</div>
      <div class="explore-wrapper">
      <div class="explore-grid" id="categoryScroller">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(category => { %>
            <div class="explore-card">
              <h3><%= category.name %></h3>
              <div class="card-image-box">
                <img 
                  src="<%= category.imageUrl || '/images/default-category.jpg' %>" 
                  alt="<%= category.name %>"
                  onerror="this.src='/images/default-category.jpg'"
                />
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <!-- Fallback if no categories -->
          <p>No categories available</p>
        <% } %>
      </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services">
      <div class="section-title">Our Services</div>
      <p class="services-intro">
        We provide many of the best services for you and you will get the best
        benefits here.
      </p>

      <div class="service-grid">
        <div class="service-item">
          <div class="service-icon"><i class="fa-solid fa-car"></i></div>
          <h4>Top Buy & Sell Car</h4>
          <p>
            We provide many of the best services for you. And you will get the
            best benefits here.
          </p>
        </div>
        <div class="service-item">
          <div class="service-icon"><i class="fa-solid fa-wallet"></i></div>
          <h4>Easy Payment</h4>
          <p>
            We provide many of the best services for you. And you will get the
            best benefits here.
          </p>
        </div>
        <div class="service-item">
          <div class="service-icon">
            <i class="fa-solid fa-file-invoice"></i>
          </div>
          <h4>Easy To Use</h4>
          <p>
            We provide many of the best services for you. And you will get the
            best benefits here.
          </p>
        </div>
      </div>
    </section>

    <!-- Promo Section -->
    <section class="promo">
      <div class="promo-image">
        <img
          src="images/Hoonigang.avif"
          alt="Promo Car"
        />
      </div>
      <div class="promo-content">
        <h2>Buy Best Remote Control Cars</h2>
        <p>
          We provide many of the best services for you and you will get the best
          benefits here.
        </p>
        <a href="#" class="btn-primary" style="background-color: #1c2e4a"
          >Book Now ></a
        >
