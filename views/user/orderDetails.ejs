<!-- HEADER -->
<header class="cart-header">
    <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
    </ul>

    <div class="logo">Wheelz</div>

    <div class="user-actions">
        <a href="/orders" class="active">Order</a>
        <a href="/cart">Cart</a>
        <a href="/wishlist">Wish List</a>
        <% if (locals.user) { %>
      <a href="/user/profile" class="profile-avatar">
            <%= (user.username || 'U').charAt(0).toUpperCase() %>
        </a>
        <% } else { %>
        <h3 class="profile-avatar"><i class="fa fa-user"></i></h3>
        <% } %>
    </div>
</header>

<div class="od-page-container">
    <div class="od-page-header">
        <h1>ORDER STATUS</h1>
        <p>MANAGE YOUR ORDER AND RETURN REQUESTS</p>
    </div>

    <div class="od-content-wrapper">
       
        <!-- LEFT PANE -->
        <div class="od-left-pane">
            <div class="order-status-container">

                <h3 class="status-title">Delivery Status</h3>

                <%
                let progress = 0;

                if(order.orderStatus === "Placed") progress = 25;
                else if(order.orderStatus === "Shipped") progress = 50;
                else if(order.orderStatus === "Out For Delivery") progress = 75;
                else if(order.orderStatus === "Delivered") progress = 100;
                %>

                <div class="status-progress-wrapper">

                <div class="progress-line"></div>

                <div class="progress-line-active" style="width:<%= progress %>%"></div>

                <div class="status-step <%= progress >= 25 ? 'active':'' %>">
                <div class="status-circle">✓</div>
                <p>Ordered</p>
                </div>

                <div class="status-step <%= progress >= 50 ? 'active':'' %>">
                <div class="status-circle"><i class="fa-solid fa-truck" style="color: #100E34;"></i></div>
                <p>Shipped</p>
                </div>

                <div class="status-step <%= progress >= 75 ? 'active':'' %>">
                <div class="status-circle"><i class="fa-solid fa-dolly" style="color: #100E34;"></i></div>
                <p>Out for delivery</p>
                </div>

                <div class="status-step <%= progress === 100 ? 'active':'' %>">
                <div class="status-circle"><i class="fa-solid fa-box" style="color: #100E34;"></i></div>
                <p>Delivered</p>
                </div>

                </div>

                <% if(order.orderStatus === "Cancelled"){ %>
                <div class="order-cancelled">Order Cancelled</div>
                <% } %>

                <% if(order.orderStatus === "Returned"){ %>
                <div class="order-returned">Order Returned</div>
                <% } %>

                </div>
            <!-- Order Information Details Box -->
            <div class="od-info-card">
                <div class="od-info-grid">
                    <div class="od-info-item">
                        <span class="od-label">ORDER ID:</span>
                        <span class="od-value"><%= (typeof order !== 'undefined' && order.orderId) ? order.orderId : '' %></span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-label">PURCHASE DATE</span>
                        <span class="od-value"><%= (typeof order !== 'undefined' && order.createdAt) ? order.createdAt.toDateString() : '' %></span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-label">TOTAL PRICE</span>
                        <span class="od-value">₹<%= (typeof order !== 'undefined' && order.finalAmount) ? order.finalAmount : '' %></span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-label">CURRENT STATUS:</span>
                        <span class="od-value"><%= (typeof order !== 'undefined' && order.orderStatus) ? order.orderStatus : '' %></span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-label">PAYMENT METHOD</span>
                        <span class="od-value"><%= (typeof order !== 'undefined' && order.paymentMethod) ? order.paymentMethod : '' %></span>
                    </div>
                </div>
            </div>

            <!-- List of Ordered Products -->
            <div class="od-products-list">
                <h3 class="od-section-title">Items Ordered</h3>

                <% if (typeof order !== 'undefined' && order.items && order.items.length > 0) { %>
                    <% order.items.forEach(item => { %>

                    <div class="od-product-row <%= item.itemStatus === 'Returned' ? 'returned-border' : '' %>">

                        <div class="od-product-img-box">
                            <img src="<%= item.image %>" alt="<%= item.name %>">
                        </div>

                        <span class="od-product-name"><%= item.name %></span>

                        <% if(order.orderStatus === "Delivered" && item.itemStatus !== "Returned"){ %>
                            <button 
                                class="return-item-btn"
                                onclick="openReturnModal('<%= order._id %>','<%= item._id %>')">
                                Return
                            </button>
                        <% } else if(item.itemStatus === "Returned"){ %>

                            <div class="return-status-box">

                                <div class="status-line">
                                    <span class="status-label">Return Status:</span>
                                    <span class="status-value return-status">
                                        <%= item.returnStatus || "Requested" %>
                                    </span>
                                </div>

                                <div class="status-line">
                                    <span class="status-label">Refund Status:</span>
                                    <span class="status-value refund-status">
                                        <%= item.refundStatus || "Pending" %>
                                    </span>
                                </div>

                            </div>

                        <% } else if((order.orderStatus === "Placed" || order.orderStatus === "Confirmed") && item.itemStatus !== "Cancelled"){ %>
                                <button 
                                    class="cancel-item-btn"
                                    onclick="cancelSpecificProduct('<%= order._id %>','<%= item._id %>')">
                                    Cancel
                                </button>
                            <% } %>

                    </div>

                    <% }) %>
                <% } %>
            </div>

        </div>

        <!-- RIGHT PANE (Actions) -->
        <div class="od-right-pane">
            
               <div class="order-address-card">

                <h3 class="address-title">SHIPPING ADDRESS</h3>

                <div class="address-content">
                    <p class="address-name"><%= order.addressSnapshot.name %></p>

                    <p>
                        <%= order.addressSnapshot.street %>
                    </p>

                    <p>
                        <%= order.addressSnapshot.city %>,
                        <%= order.addressSnapshot.pincode %>
                    </p>

                    <p>
                        <%= order.addressSnapshot.addressType %>
                    </p>

                    <p>
                        Phone: <%= order.addressSnapshot.phone %>
                    </p>
                </div>

            </div>
           
             <% const currentStatus = order.orderStatus; %>

            <% if (currentStatus === 'Delivered') { %>
                <!-- RETURN ITEM BOX -->
                 <button class="invoice-btn" onclick="window.location.href='/invoice/<%= order._id %>'">
                    Download Invoice
                 </button>

            <% } else if(order.orderStatus!=='Cancelled') { %>
                <!-- CANCEL ORDER BOX -->
                <div class="od-action-box light-action-box">
                    <h3>CANCEL ORDER</h3>
                    <p class="od-disclaimer">ORDER CANCELLATION ARE ONLY AVAILABLE BEFORE THE 'INSPECTION' PHASE OF THE RETURN PROCESS</p>
                    
                    <div class="od-form-group">
                        <label>REASON FOR CANCELLATION</label>

                        <div class="od-select-wrapper light-select">
                            <select id="cancelReason">
                                <option value="">SELECT A REASON</option>
                                <option>Found a better price elsewhere</option>
                                <option>Ordered by mistake</option>
                                <option>Delivery time is too long</option>
                                <option>Change of mind</option>
                            </select>
                        </div>
                    </div>

                    <div class="od-form-group">
                        <label>ADDITIONAL DETAILS</label>

                        <textarea 
                            id="cancelDetails"
                            rows="3"
                            placeholder="OPTIONAL REASON DETAILS..."
                        ></textarea>
                    </div>

                    <button class="od-btn-submit" onclick="cancelOrder('<%= order._id %>')">
                    CANCEL ORDER
                    </button>
                </div>
            <% } %>

         

        </div>
    </div>
</div>
<div id="returnModal" class="return-modal">
    <div class="return-modal-content">

        <h3>RETURN ITEM</h3>

        <div class="od-form-group">
            <label>REASON FOR RETURN</label>
            <div class="od-select-wrapper dark-select">
                <select id="returnReason">
                    <option value="">SELECT A REASON</option>
                    <option>Item is damaged/defective</option>
                    <option>Wrong item delivered</option>
                    <option>Not as described</option>
                    <option>Quality issues</option>
                    <option>Changed my mind</option>
                </select>
            </div>
        </div>

        <div class="od-form-group">
            <label>ADDITIONAL DETAILS</label>
            <textarea id="returnDetails" rows="4"></textarea>
        </div>

        <button onclick="returnOrder()" class="od-btn-submit">
            INITIATE RETURN
        </button>

        <button onclick="closeReturnModal()" class="od-btn-cancel">
            CLOSE
        </button>

    </div>
</div>

<script>
    let currentOrderId = null
    let currentItemId = null

    function openReturnModal(orderId,itemId){
        currentOrderId = orderId
        currentItemId = itemId
        document.getElementById("returnModal").style.display = "flex"
    }

    function closeReturnModal(){
        document.getElementById("returnModal").style.display = "none"
    }
    
    function returnOrder(){
        const reasonDiv = document.getElementById("returnReason")
        const detailsDiv = document.getElementById("returnDetails")
        let isValid = false;
        if (!reasonDiv) {
            reasonDiv.border='1px solid red'
            isValid=true;
        }
        
        if (!detailsDiv) {
            detailsDiv='1px solid red'
            isValid=true;
        }
        if(isValid){
            showError('Please Enter The Highlighted Area')
            return
        }
        const reason=reasonDiv.value.trim();
        const details=detailsDiv.value.trim();
        fetch('/returnOrder',{
            method:'POST',
            headers:{
                'Content-Type':'application/json'
            },
            body:JSON.stringify({currentOrderId,currentItemId,reason,details})
        }).then(res=>res.json())
        .then(data=>{
            if(data.success){
                showSuccess(data.message)
                setTimeout(()=>{window.location.reload()},1500)
            }else{
                showError(data.message)
            }
        })
    }

    function cancelOrder(orderId){
        const reasonDiv = document.getElementById("cancelReason");
        const detailsDiv = document.getElementById("cancelDetails");

        let isValid = true;

        // reset borders
        reasonDiv.style.border = "";
        detailsDiv.style.border = "";


        // validate reason
        if(reasonDiv.value === ""){
        reasonDiv.style.border = "2px solid red";
        showError("Please select a cancellation reason");
        isValid = false;
        }

        // validate details
        if(detailsDiv.value.trim() === ""){
        detailsDiv.style.border = "2px solid red";
        showError("Please provide additional details");
        isValid = false;
        }

        if(!isValid) return;
        const reason=reasonDiv.value.trim()
        const details=detailsDiv.value.trim()

        fetch('/cancelOrder',{
            method:'POST',
            headers:{
                'Content-Type':'application/json'
            },
            body:JSON.stringify({reason,details,orderId})
        }).then(res=>res.json())
        .then(data=>{
            if(data.success){
                showSuccess(data.message)
                setTimeout(()=>{
                    window.location.reload();
                },1500)
            }else{
                showError(data.message)
            }
        })
        
    }

    function cancelSpecificProduct(orderId,itemId){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, Cancel it!"
        }).then((result) => {
        if (result.isConfirmed) {
            fetch('/cancel-productOrder',{
            method:'POST',
            headers:{
                'Content-Type':'application/json'
            },
            body:JSON.stringify({orderId,itemId})
        }).then(res=>res.json())
        .then(data=>{
            if(data.success){
                showSuccess(data.message)
                setTimeout(()=>{window.location.reload()},1000)
            }else{
                showError(data.message)
            }
        })
        }
        });
        
    }

</script>

