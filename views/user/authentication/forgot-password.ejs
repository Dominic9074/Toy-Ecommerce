    <div class="otp-container">
        <div class="otp-card">
            <div class="otp-logo">
                <i class="fa-solid fa-hurricane"></i> Wheelz
            </div>
            
            <h2 class="otp-title">Forgot password?</h2>
            <p class="otp-subtitle">Enter your email address and we'll send a link to reset password</p>

            <form action="/forgot-password" method="POST" class="otp-form" onsubmit="validateEmail(event)">
                <div class="form-group" style="text-align: left; margin-bottom: 20px;" id="emailDiv">
                    <label style="display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 8px;">Email</label>
                    <input type="email" name="email" id="email" placeholder="example@gmail.com" class="forgot-email-input">
                    <p style="color: red;font-size: 13px;font-weight: normal;margin-top: 2px !important;display: none;"></p>
                </div>

                <button type="submit" class="otp-btn">Send Reset Link</button>
                
                <p class="resend-text">Go to <a href="/signin" class="resend-link">Sign in</a></p>
            </form>
        </div>
    </div>

    <script>

        function validateEmail(event){
            const email=document.getElementById('email').value;
            const emailDiv=document.getElementById('emailDiv');

            if(!email){
                event.preventDefault();
                emailDiv.querySelector('input').style.border='1px solid red'
                emailDiv.querySelector('p').style.display='block';
                emailDiv.querySelector('p').innerText='Email Field Is Required';
                showError('Email Field Is Required')
                return;
            }
        }

    </script>
