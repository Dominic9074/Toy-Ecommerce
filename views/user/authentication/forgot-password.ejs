<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wheelz - Forgot Password</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="otp-body"> <!-- Reusing centered layout -->
    <div class="otp-container">
        <div class="otp-card">
            <div class="otp-logo">
                <i class="fa-solid fa-hurricane"></i> Wheelz
            </div>
            
            <h2 class="otp-title">Forgot password?</h2>
            <p class="otp-subtitle">Enter your email address and we'll send a link to reset password</p>

            <form action="/send-reset-link" method="POST" class="otp-form">
                <div class="form-group" style="text-align: left; margin-bottom: 20px;">
                    <label style="display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 8px;">Email</label>
                    <input type="email" placeholder="example@gmail.com" class="forgot-email-input" required>
                </div>

                <button type="submit" class="otp-btn">Send Reset Link</button>
                
                <p class="resend-text">Go to <a href="/signin" class="resend-link">Sign in</a></p>
            </form>
        </div>
    </div>
</body>
</html>
