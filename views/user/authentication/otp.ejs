
    <div class="otp-container">
        <div class="otp-card">
            <div class="otp-logo">
                <i class="fa-solid fa-hurricane"></i> Wheelz
            </div>
            
            <h2 class="otp-title">Enter OTP</h2> 
            <p class="otp-subtitle">We have sent a OTP to your mobile Email</p>
            <p class="otp-expiry-text">OTP expires in:<span id="expiryTimer">2:00</span></p>


            <form action="/verify-otp" method="POST" class="otp-form" onsubmit="validateOtpForm(event)">
                <div class="otp-inputs">
                    <input type="text" maxlength="1" class="otp-field" >
                    <span class="otp-dash">-</span>
                    <input type="text" maxlength="1" class="otp-field" >
                    <span class="otp-dash">-</span>
                    <input type="text" maxlength="1" class="otp-field" >
                    <span class="otp-dash">-</span>
                    <input type="text" maxlength="1" class="otp-field" >
                </div>

               <input type="hidden" name="otp" id="OtpValue">

                <button type="submit" class="otp-btn">Verify</button>
                <div class="resent-otp">
                <p class="resend-text">Didn't receive code?</p> 
                <button type="button" onclick="resentOtp(event)" class="resend-link" id="resend-btn">Resend OTP</button>
                <p id="timerText" style="display:none;" class="timerText">Resend OTP in <span id="timer">60</span>s</p>
                </div>
            </form>
        </div>
    </div>

    <script>
        const purpose='<%= purpose %>'
        // Simple auto-focus script for OTP inputs
        const inputs = document.querySelectorAll('.otp-field');
        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1) {
                    if (index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value.length === 0) {
                    if (index > 0) {
                        inputs[index - 1].focus();
                    }
                }
            });
        });

        function validateOtpForm(event){
            event.preventDefault();
            if (otpExpired) {
            event.preventDefault();
            showError("OTP has expired. Please request a new OTP.")
            return;
        }
            const inputs=document.querySelectorAll('.otp-field');
            let otp='';
            for(let input of inputs){
                if(!input.value){
                    showError('Please Enter Complete Otp')
                    return;
                }
                otp+=input.value;
            }
            
            let url;
            // purpose==='forgot'?'/verify-forgot':'/verify-otp';
            switch(purpose){
                case 'forgot':
                    url='/verify-forgot';
                    break;
                case 'email':
                    url='/verify-email';
                    break;
                default:
                    url='/verify-otp';
            }
            
            
            fetch(url,{
                method:"post",
                headers:{
                    'Content-Type':'application/json'
                },
                body:JSON.stringify({otp})
            }).then(res=>res.json())
            .then(data=>{
                if(data.success){
                    showSuccess(data.message)
                    setTimeout(() => {
                   if(purpose==='forgot'){
                     window.location.href = "/new-password";
                   }else if(purpose==='signup'){
                     window.location.href = "/signin";
                   }else if(purpose==='email'){
                    window.location.href='/user/profile'
                   }
                }, 1000);
                }else{
                    showError(data.message)
                }
            })
            .catch(()=>showError('something went wrong'))
            
        }
        let timeInterval;

        function resentOtp(event){

            fetch(`/resendOtp?purpose=${purpose}`,{
                method:'post'
            }).then(res=>res.json())
            .then(data=>{
                if(data.success){
                    showSuccess(data.message);
                    startTimer();
                    clearInterval(expiryInterval);
                    startOtpExpiryTimer();
                }else{
                    showError(data.message)
                }
            })


            function startTimer(){
                let timeLeft=60;
            console.log('working')

            document.getElementById('resend-btn').style.display='none';
            document.getElementById('timerText').style.display='block'

            timeInterval=setInterval(()=>{
                timeLeft--;
                document.getElementById('timer').innerText=timeLeft;

                if(timeLeft<=0){
                    clearInterval(timeInterval);
                   document.getElementById('resend-btn').style.display='inline-block';
                   document.getElementById('timerText').style.display='none'
                }

            },1000)
            }


        }

        let expiryTime = 120; // 2 minutes
let expiryInterval;
let otpExpired = false;

const expiryDisplay = document.getElementById("expiryTimer");
const otpForm = document.querySelector(".otp-form");

function startOtpExpiryTimer() {
    expiryTime = 120;
    otpExpired = false;

    expiryInterval = setInterval(() => {

        let minutes = Math.floor(expiryTime / 60);
        let seconds = expiryTime % 60;

        seconds = seconds < 10 ? "0" + seconds : seconds;

        expiryDisplay.innerText = `${minutes}:${seconds}`;

        expiryTime--;

        if (expiryTime < 0) {
            clearInterval(expiryInterval);
            expiryDisplay.innerText = "Expired";
            otpExpired = true;
        }

    }, 1000);
}

document.addEventListener("DOMContentLoaded", function () {
    startOtpExpiryTimer();
});


</script>

    </script>
