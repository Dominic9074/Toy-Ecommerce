<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wheelz - New Password</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="otp-body"> <!-- Reusing centered layout -->
    <div class="otp-container">
        <div class="otp-card">
            <div class="otp-logo">
                <i class="fa-solid fa-hurricane"></i> Wheelz
            </div>
            
            <h2 class="otp-title" style="text-transform: uppercase;">NEW PASSWORD</h2>
            <p class="otp-subtitle" style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px; opacity: 0.8;">EMAIL VERIFICATION SUCCESSFUL</p>

            <form action="/reset-password" method="POST" class="otp-form">
                <div class="form-group" style="text-align: left; margin-bottom: 25px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #333; margin-bottom: 8px; text-transform: uppercase;">NEW PASSWORD</label>
                    <input type="password" class="forgot-email-input" required> 
                    <!-- Reusing forgot-email-input style as it fits the gray background input look -->
                </div>

                <button type="submit" class="otp-btn">RESET PASSWORD</button>
            </form>
        </div>
    </div>
</body>
</html>
