
    <header>
        <button class="hamburger" id="hamburger">
            <i class="fa-solid fa-bars"></i>
        </button>
        <ul class="nav-links" style="justify-content: flex-start;"> <!-- Left align nav links -->
            <li><a href="/">Home</a></li>
            <li><a href="/shop" class="active">Shop</a></li>
            <li><a href="/categories">Categories</a></li>
        </ul>
        
        <div class="logo">
            Wheelz
        </div>

        <div class="user-actions">
           <a href="/orders">Order</a> <!-- Matches 'Order' in image? Image says 'Order' -->
           <a href="/cart">Cart</a>
           <a href="/wishlist">Wish List</a>
           <% if (user) { %>
      <a href="/user/profile" class="profile-avatar">
        <%= user.username.charAt(0).toUpperCase() %>
      </a>
    <% } else { %>
      <a href="/signin" class="sign-in-btn">Sign In</a>
    <% } %>
        </div>
    </header>

    <div class="shop-page-container">
        
        <!-- Categories Header Section -->
        <div class="categories-left">
        <h1 class="categories-title">Categories</h1>
        <div class="categories-line"></div>
        <!-- search -->
        <div class="search-wrapper">
        <form action="/shop" method="GET">
        <button type="submit" class="search-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
        <input type="text" id="searchInput" value="<%= searchInput||'' %>" name="search" placeholder="Search products...">
        </form>
        <button type="button" id="clearSearch" class="clear-btn">
        <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      </div>

    

        <div class="shop-content-wrapper">
            <!-- Left Side: Category Pills -->
            <div class="category-wrapper">
                
                <div class="category-pills">
                    
                    <!-- All Button -->
                    <button data-category="all" class="cat-pill <%= !selectedCategory || selectedCategory === 'all' ? 'active' : '' %>">
                    All
                    </button>

                    <!-- Dynamic Categories -->
                    <% categories.forEach(cat => { %>
                    <button data-category="<%= cat._id %>" class="cat-pill <%= selectedCategory == cat._id.toString() ? 'active' : '' %>">
                        <%= cat.name %>
                    </button>
                    <% }) %>

                </div>

                </div>

            <!-- Right Side: Filter -->
            <div class="filter-box">
                <div style="display: flex;" >
                    <h3>FILTER</h3>
                <button style="margin-left: 50%;width: fit-content; height: fit-content;color: white;
                background-color: #A2001D; border: none; font-size: 18px;
                font-weight: 500;padding: 5px;cursor: pointer;" onclick="filterProducts()">Apply All</button>
                <button style="margin-left: 20px;width: fit-content; height: fit-content;color: white;
                background-color: #1c2e4a; border: none; font-size: 18px;
                font-weight: 500;padding: 5px;cursor: pointer;" onclick="window.location.href='/shop'">Clear</button>
                </div>
                <div class="filter-options">
                    <span class="filter-label">PRICE:</span>
                    <button data-price="all" class="filter-btn active">ALL</button>
                    <button data-price="asc" class="filter-btn">LOW TO HIGH</button>
                    <button data-price="dec" class="filter-btn">HIGH TO LOW</button>
                    <span class="filter-label">NAME:</span>
                    <button data-name="asc" class="filter-btn">A - Z</button>
                    <button data-name="dec" class="filter-btn">Z - A</button>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="user-product-grid">

            <% if (products && products.length > 0) { %>

                <% products.forEach(product => { %>

                <div class="user-product-card">
                    <div class="upc-heart">
                    <i class="fa-solid fa-heart <%= wishlistProductIds.includes(product._id.toString()) ? 'active-heart':'' %>"
                         onclick="addToWishlist('<%= product._id %>',this)"></i>
                    <span class="discount-badge">
                        <%= product.offer %>% OFF
                    </span>
                    </div>

                    <div class="upc-image">
                    <img src="<%= product?.images[0].url %>" 
                        alt="<%= product?.name %>">
                    </div>

                    <div class="upc-details">
                    <div class="upc-header">
                        <span class="upc-title"><%= product?.category?.name %></span>

                        <% if (product.offerPercentage && product.offerPercentage > 0) { %>
                        <span class="upc-discount">
                            <%= product.offerPercentage %>%OFF
                        </span>
                        <% } %>
                    </div>

                    <p class="upc-desc"><%= product?.name %></p>

                    <div class="upc-footer">

                    <% 
                        const originalPrice = product.price;
                        const offer = product.offer || 0;
                        const discountedPrice = Math.round(
                        originalPrice - (originalPrice * offer / 100)
                        );
                    %>

                    <% if (offer > 0) { %>
                        
                        <div class="price-wrapper">
                        <span class="original-price">
                            ₹<%= originalPrice %>
                        </span>

                        <span class="upc-price">
                            ₹<%= discountedPrice %>
                        </span>
                        </div>

                    <% } else { %>

                        <span class="upc-price">
                        ₹<%= originalPrice %>
                        </span>

                    <% } %>

                    <button class="upc-order-btn" onclick="productDetails(`<%= product.slug %>`)" >Order Now</button>

                    </div>
                    </div>
                </div>

                <% }) %>

            <% } else { %>

                <p style="grid-column: 1/-1; text-align:center;">No products found</p>

            <% } %>

            </div>
    </div>
    <div class="pagination-wrapper">
                    <% 
                        const maxVisible = 4;

                        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                        let endPage = startPage + maxVisible - 1;

                        if (endPage > pageCount) {
                            endPage = pageCount;
                            startPage = Math.max(1, endPage - maxVisible + 1);
                        }
                    %>

                    <div class="pagination">

                        <% if (currentPage > 1) { %>
                            <button type="button"
                                class="page-link"
                                onclick="goToPage(<%= currentPage - 1 %>)">
                            &lt;
                        </button>
                        <% } %>

                        <% for (let i = startPage; i <= endPage; i++) { %>
                            <button type="button"
                                class="page-link <%= currentPage === i ? 'active' : '' %>"
                                onclick="goToPage(<%= i %>)">
                            <%= i %>
                        </button>
                        <% } %>

                        <% if (currentPage < pageCount) { %>
                            <button type="button"
                                    class="page-link"
                                    onclick="goToPage(<%= currentPage + 1 %>)">
                                &gt;
                            </button>
                        <% } %>

                    </div>


            </div>
          </div>

    <script>
        const hamburger = document.getElementById("hamburger");
        const navLinks = document.querySelector(".nav-links");
        const userActions = document.querySelector(".user-actions");
        
        hamburger.addEventListener("click", () => {
            navLinks.classList.toggle("active");
            userActions.classList.toggle("active");
        });
        const searchInput = document.getElementById("searchInput");
        const clearBtn = document.getElementById("clearSearch");

        searchInput.addEventListener("input", function () {
            clearBtn.style.display = this.value.length ? "block" : "none";
        });

        clearBtn.addEventListener("click", function () {
            searchInput.value = "";
            clearBtn.style.display = "none";
            filter.search=''
            searchInput.focus();
        });
        const categoryContainer = document.querySelector(".category-pills");

        categoryContainer.addEventListener("wheel", (e) => {
            e.preventDefault();
            categoryContainer.scrollLeft += e.deltaY;
        });
        const filter={
            search:"",
            category:"",
            price:'',
            name:'',
            page:1
        }
        // Sync filter.page with current page from server
        filter.page = <%= currentPage %>;
        function goToPage(pageNumber) {
            filter.page = pageNumber;
            filterProducts();
        }
        
        document.querySelectorAll('.cat-pill').forEach(btn=>{
            btn.addEventListener('click',function(){
                filter.category=this.dataset.category;
                document.querySelectorAll('.cat-pill').forEach(b => {
                b.classList.remove('active');
        });

        // Add active to clicked
        this.classList.add('active');
            })
        })
        document.getElementById('searchInput').addEventListener('input',function(){
            filter.search=this.value;
            console.log(filter)
        })
        document.querySelectorAll('.filter-btn').forEach(btn=>{
            btn.addEventListener('click',function(){
                if(this.dataset.price){
                    document.querySelectorAll('[data-price]').forEach(b => {
                        b.classList.remove('active');
                    });
                    // Add active to clicked button
                    this.classList.add('active');
                    filter.price=this.dataset.price
                }else{
                    document.querySelectorAll('[data-name]').forEach(b => {
                        b.classList.remove('active');
                    });

                    // Add active to clicked button
                    this.classList.add('active');
                    filter.name=this.dataset.name
                }
            })
        })
        function filterProducts(){
            const queryParams = new URLSearchParams(filter).toString();
            fetch(`/shop?${queryParams}`,{
                method:'GET',
                headers:{
                    'Accept':'application/json'
                }
            }).then(res => res.json())
                .then(data => {
                if (data.success) {
                    filter.page = data.currentPage;
                    renderProducts(data.products,data.wishlistProductIds);
                    renderPagination(data.pageCount)
                }})
        }

        function renderProducts(products,wishlistProductIds=[]){
            const grid = document.querySelector('.user-product-grid');

            if(!products.length){
                grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;">No products found</p>`;
                return;
            }

            let html = '';

            products.forEach(product => {

                const offer = product.offer || 0;
                const originalPrice = product.price;
                const discountedPrice = offer > 0
                    ? Math.round(originalPrice - (originalPrice * offer / 100))
                    : originalPrice;

                html += `
                <div class="user-product-card">
                    <div class="upc-heart">
                        <i class="fa-solid fa-heart ${wishlistProductIds.includes(product._id.toString()) ? 'active-heart' : ''}"
                             onclick="addToWishlist('${product._id}',this)">
                        </i>
                        ${offer > 0 ? `<span class="discount-badge">${offer}% OFF</span>` : ''}
                    </div>

                    <div class="upc-image">
                        <img src="${product.images?.[0]?.url || ''}" alt="${product.name}">
                    </div>

                    <div class="upc-details">
                        <div class="upc-header">
                            <span class="upc-title">${product.category?.name || ''}</span>
                        </div>

                        <p class="upc-desc">${product.name}</p>

                        <div class="upc-footer">
                            ${
                                offer > 0
                                ? `<div class="price-wrapper">
                                    <span class="original-price">₹${originalPrice}</span>
                                    <span class="upc-price">₹${discountedPrice}</span>
                                </div>`
                                : `<span class="upc-price">₹${originalPrice}</span>`
                            }
                            <button class="upc-order-btn" onclick="productDetails('${product.slug}')">Order Now</button>
                        </div>
                    </div>
                </div>
                `;
            });

            grid.innerHTML = html;
}

    function renderPagination(pageCount) {

        const container = document.querySelector(".pagination");
        container.innerHTML = "";

        if (pageCount <= 1) return;

        const maxVisible = 4;
        const currentPage = filter.page;

        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = startPage + maxVisible - 1;

        if (endPage > pageCount) {
            endPage = pageCount;
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        // Previous
        if (currentPage > 1) {
            container.innerHTML += `
                <button class="page-link" onclick="goToPage(${currentPage - 1})">&lt;</button>
            `;
        }

        // Pages
        for (let i = startPage; i <= endPage; i++) {
            container.innerHTML += `
                <button class="page-link ${i === currentPage ? 'active' : ''}"
                    onclick="goToPage(${i})">
                    ${i}
                </button>
            `;
        }

        // Next
        if (currentPage < pageCount) {
            container.innerHTML += `
                <button class="page-link" onclick="goToPage(${currentPage + 1})">&gt;</button>
            `;
        }
    }

    function productDetails(slug){
        window.location.href=`/product/${slug}`
    }
    function addToWishlist(productId,icon){
        fetch('/addWishlist',{
            method:'POST',
            headers:{
                'Content-Type':'application/json'
            },
            body:JSON.stringify({productId})
        }).then(res => res.json())
        .then(data =>{
            if(data.success){
                showSuccess(data.message);
                icon.classList.toggle('active-heart');
            }else{
                showError(data.message)
            }
        })
    }

    document.addEventListener("DOMContentLoaded", function() {
        renderPagination(<%= pageCount %>);
    });
    </script>
