

      <header>
  
  <!-- Hamburger Button (Mobile Only) -->
  <button class="hamburger" id="hamburger" type="button">
  <i class="fa-solid fa-bars"></i>
  </button>

  <ul class="nav-links" id="mobileMenu">
    <li><a href="/">Home</a></li>
    <li><a href="/shop">Shop</a></li>
  </ul>

  <div class="logo">Wheelz</div>

  <div class="user-actions nav-links" style="list-style-type: none; padding-left: 0; margin: 0;">
    <li><a href="/orders">Order</a></li>
    <li><a href="/cart">Cart</a></li>
    <li><a href="/wishlist">Wishlist</a></li>

    <% if (user) { %>
      <a href="/user/profile" class="profile-avatar">
        <%= user.username.charAt(0).toUpperCase() %>
      </a>
    <% } else { %>
      <a href="/signin" class="sign-in-btn">Sign In</a>
    <% } %>
  </div>

</header>

    <div class="shop-page-container">
        
        <!-- Categories Header Section -->
        <div class="categories-left">
        <h1 class="categories-title" style="background-color: transparent;">Wishlist</h1>
        <div class="categories-line"></div>
        <!-- search -->
        <div class="search-wrapper">
        <form action="/wishlist" method="GET">
    
            <button type="submit" style="background:none;border:none;cursor:pointer;">
                <i class="fa-solid fa-magnifying-glass search-icon" style="padding-top: 25px;"></i>
            </button>

            <input type="text"
                id="searchInput"
                name="search"
                placeholder="Search products..."
                value="<%= searchInput || '' %>">

            <button type="button"
                    id="clearSearch"
                    class="clear-btn"
                    onclick="clearSearchInput()">
                <i class="fa-solid fa-xmark" style="padding-top: 25px;"></i>
            </button>
        </form>
      </div>
      </div>

    

        

        <!-- Product Grid -->
       <div class="user-product-grid">

        <% if (products && products.length > 0) { %>

            <% products.forEach(product => { %>

            <div class="user-product-card">
                <div class="upc-heart">
                    <i class="fa-solid fa-heart active-heart"
                    onclick="removeFromWishlist('<%= product._id %>', this)">
                    </i>
                </div>

                <div class="upc-image">
                    <img src="<%= product?.images?.[0]?.url %>" 
                        alt="<%= product?.name %>">
                </div>

                <div class="upc-details">
                    <div class="upc-header">
                        <span class="upc-title">
                            <%= product?.category?.name %>
                        </span>

                        <% if (product.offer && product.offer > 0) { %>
                            <span class="upc-discount">
                                <%= product.offer %>%OFF
                            </span>
                        <% } %>
                    </div>

                    <p class="upc-desc"><%= product?.name %></p>

                    <div class="upc-footer">

                        <% 
                            const originalPrice = product.price;
                            const offer = product.offer || 0;
                            const discountedPrice = offer > 0
                                ? Math.round(originalPrice - (originalPrice * offer / 100))
                                : originalPrice;
                        %>

                        <% if (offer > 0) { %>
                            <div class="price-wrapper">
                                <span class="original-price">
                                    ₹<%= originalPrice %>
                                </span>
                                <span class="upc-price">
                                    ₹<%= discountedPrice %>
                                </span>
                            </div>
                        <% } else { %>
                            <span class="upc-price">
                                ₹<%= originalPrice %>
                            </span>
                        <% } %>

                        <button class="upc-order-btn"
                            onclick="productDetails('<%= product.slug %>')">
                            Order Now
                        </button>

                    </div>
                </div>
            </div>

            <% }) %>

        <% } else { %>

            <p style="grid-column:1/-1;text-align:center;">
                Your wishlist is empty
            </p>

        <% } %>

    </div>
    </div>

    <script>
        const hamburger = document.getElementById("hamburger");
        const navLinks = document.querySelector(".nav-links");
        const userActions = document.querySelector(".user-actions");

        hamburger.addEventListener("click", () => {
            navLinks.classList.toggle("active");
            userActions.classList.toggle("active");
        });
        const searchInput = document.getElementById("searchInput");
        const clearBtn = document.getElementById("clearSearch");

        searchInput.addEventListener("input", function () {
            clearBtn.style.display = this.value.length ? "block" : "none";
        });

        clearBtn.addEventListener("click", function () {
            searchInput.value = "";
            clearBtn.style.display = "none";
            searchInput.focus();
        });
        function productDetails(slug){
        window.location.href=`/product/${slug}`
    }

    function removeFromWishlist(productId,icon){
        icon.classList.toggle('active-heart');
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
            }).then((result) => {
            if (result.isConfirmed) {
                fetch('/addWishlist',{
                    method:'POST',
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify({productId})
                }).then(res => res.json())
                .then(data =>{
                    if(data.success){
                        showSuccess(data.message);
                        setTimeout(()=>{
                            location.reload();
                        },1000)
                    }else{
                        showError(data.message)
                    }
                })
            }
            });
            
    }

    </script>
